		{
			"label": "Play with touch controls",
			"type": "shell",
			"command": "${workspaceFolder}\\sdv.cmd",
			"args": ["touch"],
			"presentation": { "reveal": "silent", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "Smoke test",
			"type": "shell",
			"command": "${workspaceFolder}\\sdv.cmd",
			"args": ["test"],
			"group": "test",
			"problemMatcher": []
