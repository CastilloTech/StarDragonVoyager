			"command": "${workspaceFolder}\\sdv.cmd",
			"args": ["play"],
			"group": { "kind": "build", "isDefault": true },
			"presentation": { "reveal": "silent", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "Open Godot editor",
			"type": "shell",
			"command": "${workspaceFolder}\\sdv.cmd",
			"args": ["edit"],
			"problemMatcher": []
